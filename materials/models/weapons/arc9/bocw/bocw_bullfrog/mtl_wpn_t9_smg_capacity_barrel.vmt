"VertexLitGeneric"
{
    "$basetexture" "models\weapons\arc9\bocw\bocw_bullfrog\mtl_wpn_t9_smg_capacity_barrel_rgb"
    "$bumpmap" "models\weapons\arc9\bocw\bocw_bullfrog\mtl_wpn_t9_smg_capacity_barrel_n"
    "$phongexponenttexture" "models\weapons\arc9\bocw\bocw_bullfrog\mtl_wpn_t9_smg_capacity_barrel_e"

    /////////////////
    "$color2" "[0 0 0]"                                     //do not touch this
    "$blendtintbybasealpha" "1"                             //do not touch this
    /////////////////

    "$phong" "1"
    "$phongboost" "1"
    "$phongalbedotint" "1"
    "$phongalbedoboost" "10"                                //toy around with this
    "$phongfresnelranges" "[1 0.1 0]"

    //rimlight doesn't properly show in hlmv, make sure you're changing these values in game
    "$rimlight" "1"
    "$rimlightexponent" "100"
    "$rimmask" "1"
    "$rimlightboost" "1"
       
    /////////////////
    "$normalmapalphaenvmapmask" "1"                         //do not touch this
    /////////////////

    "$envmap" "\specularity_00"
    "$envmaptint" "[0.157 0.153 0.153]"                 

    "$detail" ""
    "$detailblendfactor" "0.5"
    "$detailblendmode" "2"

    //remove this if not using MWB
    "Proxies"
    {
        "Arc9EnvMapTint"
        {
            "min" "0"
            "max" "1"
            "envmap" "\specularity_00"
            "color" "[0.157 0.153 0.153]"
        }
        "CustomCamo" 
        {
            camoTexture $detail
            camoScale $detailscale
            blend $detailblendfactor
        }
    }
}